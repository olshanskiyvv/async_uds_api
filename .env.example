# UDS Partner API — live company credentials (test usage only).
# Copy to `.env` and fill in. `.env` is gitignored; do not commit secrets.

UDS_COMPANY_ID=
UDS_API_KEY=

# Phone used for operations without a code (customers.find / operations.create
# by phone instead of a discount code). E.164 with a leading plus, e.g.
# +79123456789 (httpx URL-encodes the '+' automatically).
UDS_PHONE=

# Optional base URL override. Default: https://api.uds.app/partner/v2
UDS_BASE_URL=https://api.uds.app/partner/v2

# Discount codes for points / certificate scenarios are provided on demand and
# are NOT stored here (they are short-lived/specific to a scenario).
